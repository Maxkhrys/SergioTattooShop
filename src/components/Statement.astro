<!-- Deliberate text-only beat between the specialty cards and the gallery
     wall — a pause before the image-heavy sections start. -->
<section class="relative py-24 md:py-32">
  <div class="mx-auto max-w-3xl px-5 text-center md:px-8">
    <span class="mx-auto mb-8 block h-px w-16 bg-blood/70 shadow-[0_0_10px_rgba(224,32,42,0.7)]" data-reveal></span>
    <p
      class="font-display text-2xl leading-snug font-light tracking-wide text-bone italic sm:text-3xl md:text-4xl"
      data-reveal
      data-reveal-delay="0.1"
    >
      "Every piece starts with a conversation, not a flash sheet — your idea,
      your placement, your story. Then my drawing."
    </p>
    <p class="font-display mt-8 text-[0.75rem] tracking-[0.28em] text-bone-dim uppercase" data-reveal data-reveal-delay="0.2">
      — Sergio Furlan
    </p>
  </div>
</section>
