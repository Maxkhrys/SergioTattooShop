---
import HighlightIcon from './HighlightIcon.astro';
---

<section id="top" class="relative flex min-h-svh items-center overflow-hidden pt-18">
  <div class="absolute inset-0">
    <img
      src="/images/hero.jpg"
      alt=""
      class="h-full w-full object-cover opacity-70"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-gradient-to-r from-ink via-ink/80 to-ink/30"></div>
    <div class="absolute inset-x-0 bottom-0 h-40 bg-gradient-to-t from-ink to-transparent"></div>
  </div>

  <div class="relative mx-auto w-full max-w-7xl px-5 py-24 md:px-8">
    <p class="section-kicker mb-6" data-reveal>
      Dublin · Tattoo Artist
    </p>

    <!-- [PLACEHOLDER: real logo/icon set — supplied separately. Wordmark below stands in for the brand mark.] -->
    <h1
      class="font-display max-w-4xl text-6xl leading-[0.95] font-semibold tracking-tight uppercase sm:text-7xl lg:text-8xl"
      data-reveal
      data-reveal-delay="0.1"
    >
      Sergio<br />
      <span class="relative inline-block">
        Furlan
        <span class="absolute -bottom-2 left-0 h-[3px] w-full bg-blood shadow-[0_0_16px_rgba(224,32,42,0.8)]"></span>
      </span>
    </h1>

    <p
      class="font-display mt-10 text-xl font-light tracking-[0.3em] text-bone-dim uppercase md:text-2xl"
      data-reveal
      data-reveal-delay="0.2"
    >
      Living art on skin
    </p>

    <div class="mt-12 flex flex-wrap items-center gap-4" data-reveal data-reveal-delay="0.3">
      <a href="#booking" class="btn-primary">Book a Consultation</a>
      <a href="#gallery" class="btn-ghost">View Work</a>
    </div>

    <!-- Immediate specialty markers — the red-icon-in-black-circle system -->
    <ul class="mt-20 flex flex-wrap gap-x-12 gap-y-8" data-reveal data-reveal-delay="0.4">
      {
        [
          { icon: 'shade', label: 'Black & Grey' },
          { icon: 'drop', label: 'Colour Realism' },
          { icon: 'triangle', label: 'Cover Up' },
        ].map(({ icon, label }) => (
          <li class="flex items-center gap-4">
            <HighlightIcon icon={icon as 'shade' | 'drop' | 'triangle'} size="sm" />
            <span class="font-display text-[0.78rem] tracking-[0.24em] uppercase text-bone-dim">
              {label}
            </span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
