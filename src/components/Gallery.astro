---
import { gallery } from '../data/site';

const filters = [
  { id: 'all', label: 'All Work' },
  { id: 'black-grey', label: 'Black & Grey' },
  { id: 'colour-realism', label: 'Colour Realism' },
  { id: 'cover-up', label: 'Cover Up' },
];

const INITIAL_COUNT = 9;
---

<section id="gallery" class="relative py-28 md:py-36">
  <div class="blood-divider mx-auto mb-28 max-w-4xl md:mb-36"></div>

  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-12 flex flex-wrap items-end justify-between gap-8" data-reveal>
      <div class="max-w-2xl">
        <p class="section-kicker mb-4">Portfolio</p>
        <h2 class="section-title text-4xl md:text-5xl">The work speaks first</h2>
      </div>
      <div class="flex flex-wrap gap-3" role="group" aria-label="Filter gallery by specialty">
        {
          filters.map((f, i) => (
            <button class="filter-pill" data-filter={f.id} aria-pressed={i === 0 ? 'true' : 'false'}>
              {f.label}
            </button>
          ))
        }
      </div>
    </div>

    <!-- Editorial masonry: real photo aspect ratios instead of a uniform
         grid, so the wall of tattoos reads as curated rather than dumped -->
    <div class="columns-1 gap-5 sm:columns-2 lg:columns-3 lg:gap-7" data-expandable data-initial-count={INITIAL_COUNT}>
      {
        gallery.map((item, i) => (
          <figure
            class:list={['gallery-piece mb-5 break-inside-avoid lg:mb-7', { hidden: i >= INITIAL_COUNT }]}
            data-category={item.category}
            data-expand-item
            data-reveal
            data-reveal-delay={String((i % 3) * 0.1)}
          >
            <img
              src={item.src}
              alt={item.alt}
              class="h-auto w-full object-cover"
              loading="lazy"
              decoding="async"
            />
          </figure>
        ))
      }
    </div>

    <div class="mt-14 flex flex-col items-center gap-6" data-reveal>
      {
        gallery.length > INITIAL_COUNT && (
          <button type="button" class="btn-ghost" data-expand-toggle>
            View Full Portfolio (<span data-expand-count>+{gallery.length - INITIAL_COUNT}</span>)
          </button>
        )
      }
      <p class="text-center text-sm text-bone-dim">
        More on Instagram —
        <a
          href="https://www.instagram.com/sergiofurlantattoo/"
          class="text-blood underline-offset-4 transition-colors hover:text-bone hover:underline"
          rel="noopener"
          target="_blank">@sergiofurlantattoo</a
        >
      </p>
    </div>
  </div>
</section>
