---
---

<section id="studio" class="relative py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-14 max-w-2xl" data-reveal>
      <p class="section-kicker mb-4">The Studio</p>
      <h2 class="section-title text-4xl md:text-5xl">Dublin, by appointment</h2>
    </div>

    <div class="grid gap-10 lg:grid-cols-5 lg:gap-8">
      <!-- [PLACEHOLDER: Sergio studio photo — neon interior] -->
      <div class="gallery-piece aspect-[16/10] lg:col-span-3" data-reveal>
        <img
          src="/images/studio-wide.svg"
          alt="Sergio Furlan's neon-lit private tattoo studio in Dublin — placeholder for interior photo"
          class="h-full w-full object-cover"
          loading="lazy"
          decoding="async"
        />
      </div>

      <div class="flex flex-col gap-8 lg:col-span-2" data-reveal data-reveal-delay="0.15">
        <div class="gallery-piece hidden aspect-[4/3] sm:block">
          <img
            src="/images/studio-detail.svg"
            alt="Studio workstation detail — placeholder"
            class="h-full w-full object-cover"
            loading="lazy"
            decoding="async"
          />
        </div>

        <div class="space-y-6 rounded-sm border border-white/5 bg-ink-soft p-8">
          <div>
            <p class="font-display text-[0.7rem] tracking-[0.24em] uppercase text-blood">Address</p>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-bone-dim">
              [PLACEHOLDER: studio address]<br />Dublin, Ireland
            </p>
          </div>
          <div>
            <p class="font-display text-[0.7rem] tracking-[0.24em] uppercase text-blood">Hours</p>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-bone-dim">
              [PLACEHOLDER: opening hours]<br />Appointment only — no walk-ins
            </p>
          </div>
          <div>
            <p class="font-display text-[0.7rem] tracking-[0.24em] uppercase text-blood">Getting here</p>
            <p class="mt-2 text-[0.95rem] leading-relaxed text-bone-dim">
              [PLACEHOLDER: transport / parking notes]
            </p>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
