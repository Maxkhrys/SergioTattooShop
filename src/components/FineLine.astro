---
import { fineLineGallery, site } from '../data/site';
---

<!--
  Fine Line — deliberate tonal shift. Lighter ground, thinner type,
  slower reveals. Same site, quieter register: mirrors how Sergio keeps
  @sergiofurlanfineline as its own sub-brand on Instagram.
-->
<section id="fine-line" class="fineline-register relative py-32 md:py-44">
  <div class="mx-auto max-w-6xl px-5 md:px-8">
    <div class="mx-auto max-w-2xl text-center" data-reveal-slow>
      <p class="section-kicker mb-5">A Different Side of the Same Hand</p>
      <h2 class="font-display text-4xl font-light tracking-wide uppercase md:text-5xl">
        Fine Line
      </h2>
      <div class="mx-auto mt-8 h-px w-16 bg-blood-dim/40"></div>
      <p class="mt-8 text-[1.02rem] leading-loose font-light text-fineline-ink/70">
        Away from the bold realism and heavy shading, Sergio keeps a dedicated
        practice for delicate work — botanicals, minimal symbols, single-needle
        line pieces. Quieter tattoos, held to the same standard, kept
        deliberately separate so neither side dilutes the other.
      </p>
    </div>

    <!-- [PLACEHOLDER: fine line gallery images] -->
    <div class="mt-20 grid grid-cols-2 gap-5 md:grid-cols-3 md:gap-8">
      {
        fineLineGallery.map((item, i) => (
          <figure class="gallery-piece aspect-[4/5]" data-reveal-slow data-reveal-delay={String((i % 3) * 0.18)}>
            <img src={item.src} alt={item.alt} class="h-full w-full object-cover" loading="lazy" decoding="async" />
          </figure>
        ))
      }
    </div>

    <div class="mt-16 text-center" data-reveal-slow>
      <p class="text-sm font-light text-fineline-ink/60">
        Dedicated fine line profile —
        <a
          href={site.instagramFineLine}
          class="text-blood-dim underline-offset-4 transition-colors hover:text-blood hover:underline"
          rel="noopener"
          target="_blank">@sergiofurlanfineline</a
        >
      </p>
    </div>
  </div>
</section>
