---
import HighlightIcon from './HighlightIcon.astro';

const specialties = [
  {
    icon: 'shade',
    title: 'Black & Grey',
    description:
      'Depth, contrast and smooth shading — portraits, statues and dark surrealism built to hold their weight for decades.',
    filter: 'black-grey',
  },
  {
    icon: 'drop',
    title: 'Colour Realism',
    description:
      'Saturated, lifelike colour work — animals, portraits and nature pieces engineered for vibrancy that survives the heal.',
    filter: 'colour-realism',
  },
  {
    icon: 'triangle',
    title: 'Cover Up',
    description:
      'Old ink, regretted names, faded work — redesigned and buried under a piece you actually want to show off.',
    filter: 'cover-up',
  },
] as const;
---

<section id="specialties" class="relative py-28 md:py-36">
  <div class="mx-auto max-w-7xl px-5 md:px-8">
    <div class="mb-16 max-w-2xl" data-reveal>
      <p class="section-kicker mb-4">What I Do</p>
      <h2 class="section-title text-4xl md:text-5xl">Three pillars.<br />One hand.</h2>
    </div>

    <div class="grid gap-px overflow-hidden rounded-sm bg-white/5 md:grid-cols-3">
      {
        specialties.map((s, i) => (
          <article
            class="group flex flex-col bg-ink p-10 transition-colors duration-500 hover:bg-ink-soft"
            data-reveal
            data-reveal-delay={String(i * 0.12)}
          >
            <HighlightIcon icon={s.icon} size="md" />
            <h3 class="font-display mt-8 text-2xl font-medium tracking-wide uppercase">{s.title}</h3>
            <p class="mt-4 flex-1 text-[0.95rem] leading-relaxed text-bone-dim">{s.description}</p>
            <a
              href="#gallery"
              data-filter-jump={s.filter}
              class="font-display mt-8 inline-flex items-center gap-2 text-[0.75rem] tracking-[0.2em] uppercase text-blood transition-colors duration-300 hover:text-bone"
            >
              See the work <span aria-hidden="true" class="transition-transform duration-300 group-hover:translate-x-1">→</span>
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
